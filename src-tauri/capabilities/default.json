{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "dialog:default",
    "allow-md-files",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "**" },
        { "path": "**/*" },
        { "path": "$HOME/**" },
        { "path": "$HOME/**/*" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOCUMENT/**/*" },
        { "path": "$DESKTOP/**" },
        { "path": "$DESKTOP/**/*" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOWNLOAD/**/*" },
        { "path": "C:/**" },
        { "path": "D:/**" },
        { "path": "E:/**" },
        { "path": "F:/**" },
        { "path": "G:/**" }
      ]
    }
  ]
}
